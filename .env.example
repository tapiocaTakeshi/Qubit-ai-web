# RunPod serverless endpoint settings (server-side only; never exposed to the browser)
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RUNPOD_ENDPOINT_ID=aic6yigpthbck5
# Optional alias for 3B routing. Use the same ID when standard and 3B share one endpoint.
RUNPOD_3B_ENDPOINT_ID=aic6yigpthbck5
# Enable only after deploying the matching Qubit agent backend.
QUBIT_AGENT_ENABLED=false
